# Supabase Configuration (only URL needed - no service role key!)
SUPABASE_URL=https://qpyahclfoywwcoekvzea.supabase.co

# Worker API Secret (must match the one in edge function, default works out of box)
GPU_WORKER_SECRET=mineedit-gpu-worker-secret-2024

# Worker Configuration
WORKER_ID=worker-1
POLL_INTERVAL_MS=5000
MAX_CONCURRENT_JOBS=6

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
USE_NVENC=false

# Temp directory for rendering
TEMP_DIR=/tmp/mineedit-renders

# Logging
LOG_LEVEL=info
